{
  "name": "squad-identity",
  "version": "1.0.0",
  "description": "GitHub App bot-identity governance for Squad agents. Ensures every git write uses the correct App[bot] identity, not the operator's personal token.",
  "keywords": ["identity", "github-app", "bot", "security", "governance", "token", "squad"],
  "author": "Sabbour",
  "source": "Sabbour/squad-identity",
  "license": "MIT",
  "requires": {
    "extension": "squad-identity",
    "scripts": ["resolve-token.mjs", "post-flight-check.mjs", "configure-identity.mjs"]
  },
  "install": "bash install.sh [/path/to/target-repo]",
  "marketplace": "squad plugin marketplace add Sabbour/squad-identity"
}
