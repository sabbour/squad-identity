{
  "name": "@sabbour/squad-identity",
  "version": "1.2.0",
  "description": "GitHub App bot-identity governance for Squad agents. Ensures every git write uses the correct App[bot] identity, not the operator's personal token.",
  "type": "module",
  "bin": {
    "squad-identity": "./bin/squad-identity.mjs"
  },
  "files": [
    "bin/",
    "extensions/",
    "squad-identity/SKILL.md",
    "identity/config.json.template",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "test:watch": "node --test --watch test/*.test.mjs",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "changeset publish"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "identity",
    "github-app",
    "bot",
    "security",
    "governance",
    "token",
    "squad",
    "copilot-cli"
  ],
  "author": "Sabbour",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sabbour/squad-identity.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0"
  }
}
